    "/api/ordens-servico": {
      "get": {
        "tags": [
          "OrdensServico"
        ],
        "summary": "Lista as ordens de serviço ativas, ordenadas por prioridade de status\r\n(Em Execução → Aguardando Pagamento → Aguardando Aprovação → Em Diagnóstico → Recebida)\r\ne, dentro do mesmo status, das mais antigas para as mais recentes. OS finalizadas,\r\nentregues e canceladas são omitidas, exceto quando incluirConcluidas = true.",
        "parameters": [
          {
            "name": "incluirConcluidas",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "OrdensServico"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrdemServicoDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrdemServicoDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrdemServicoDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
