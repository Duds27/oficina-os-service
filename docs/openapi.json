    "/api/ordens-servico/{id}/cancelar": {
      "post": {
        "tags": [
          "OrdensServico"
        ],
        "summary": "Pede o cancelamento da OS. Responde 202: a saga aplica a compensação do estado atual\r\n(devolve peças, cancela orçamento e execução, estorna o pagamento se já foi pago).\r\nOS em execução ou já encerrada não pode ser cancelada (409).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelarOrdemServicoDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelarOrdemServicoDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CancelarOrdemServicoDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/CancelamentoSolicitadoDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelamentoSolicitadoDto"
                }
              },
              "text/json": {
                "schema": {
